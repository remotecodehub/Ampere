<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>
      true
    </BlazorDisableThrowNavigationException>
    <UserSecretsId>
      b9164704-a9b8-4a4d-a6f1-e778d870653c
    </UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions"
      Version="3.0.2" />
    <PackageReference
      Include="Microsoft.EntityFrameworkCore.Design"
      Version="10.0.11">
      <IncludeAssets>
        runtime; build; native; contentfiles;
        analyzers; buildtransitive
      </IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference
      Include="Microsoft.AspNetCore.OpenApi"
      Version="10.0.11" />
    <PackageReference Include="MudBlazor"
      Version="9.8.0" />
    <PackageReference Include="Scalar.AspNetCore"
      Version="2.16.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\Ampere.Application\Ampere.Application.csproj" />
    <ProjectReference
      Include="..\Ampere.Composition\Ampere.Composition.csproj" />
  </ItemGroup>
</Project>
