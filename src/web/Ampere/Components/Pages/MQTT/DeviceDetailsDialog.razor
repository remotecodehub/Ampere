@using Ampere.Application.MQTT.Responses
@using MudBlazor
@inherits MudDialogBase

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">
                @Client.ClientId
            </MudText>
            <MudText>
                User: @Client.UserName
            </MudText>
            <MudText>
                Endpoint: @Client.Endpoint
            </MudText>
            <MudText>
                Connected: @Client.ConnectedAt
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public MqttClientResponse Client { get; set; } = null!;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    private void Close()
    {
        Dialog.Close();
    }
}
